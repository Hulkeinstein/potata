# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_TRYON=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# Resend (Email)
RESEND_API_KEY=
# production 필수: Resend에서 인증한 도메인의 발신 주소(예: Potata <verify@example.com>).
# 누락 시 production 이메일 발송은 설정 오류로 중단한다.
EMAIL_FROM=
# 로컬 개발에서만 `preview` 사용 가능. production에서는 무시되고 Resend가 필요하다.
EMAIL_DELIVERY_MODE=

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# NextAuth v5
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (소셜 로그인) — Google Cloud Console > APIs & Services > Credentials 에서 발급
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (운영 도메인도 추가)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Replicate (AI try-on) — 서버 전용
REPLICATE_API_TOKEN=

# Supabase Storage — Project Settings > API
# SUPABASE_SERVICE_ROLE_KEY는 서버 전용 비밀키(절대 클라/공개 금지).
# public 버킷: ootd-images, product-images, review-images
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 권한 allowlist(콤마 구분 이메일) — 이 목록의 이메일만 /admin 접근
ADMIN_EMAILS=
